generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String? @unique
  password String
  role     Role    @default(AGENT_NE)
  username String  @unique

  // Inverse relations (audit)
  shipmentsCreated     Shipment[]        @relation("ShipmentCreatedBy")
  paymentsCreated      Payment[]         @relation("PaymentCreatedBy")
  expensesCreated      Expense[]         @relation("ExpenseCreatedBy")
  invoicesCreated      Invoice[]         @relation("InvoiceCreatedBy")
  foodSalesCreated     FoodSale[]        @relation("FoodSaleCreatedBy")
  foodComplaintsCreated FoodComplaint[]  @relation("FoodComplaintCreatedBy")
  foodComplaintsHandled FoodComplaint[]  @relation("FoodComplaintHandledBy")
  foodRecallsCreated   FoodRecall[]      @relation("FoodRecallCreatedBy")
  notificationsSent    NotificationLog[]
}

model Shipment {
  trackingId         String         @unique
  receiverName       String
  receiverEmail      String
  receiverPhone      String?
  originCountry      String
  receiverAddress    String?
  receiverCity       String?
  receiverPoBox      String?
  destinationCountry String
  weightKg           Float?
  notes              String?
  status             ShipmentStatus @default(CREATED)
  statusHistory      Json?
  currentLocation    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime?      @updatedAt // ✅ AJOUTEZ CETTE LIGNE

  convoyId          String?
  id                Int             @id @default(autoincrement())
  thankYouEmailSent Boolean         @default(false)

  // Infos du récupérateur au Niger (CA → NE uniquement)
  pickupLastName    String?
  pickupFirstName   String?
  pickupQuartier    String?
  pickupPhone       String?

  // Paiement
  paymentStatus     PaymentStatus   @default(UNPAID)
  totalAmount       Float?                              // Prix convenu avec le client (source de facture)
  amountPaid        Float?                              // Cumul reçu (jusqu'à totalAmount)
  currency          Currency        @default(CAD)

  // Timestamps des transitions de statut (pour la timeline publique)
  readyAt           DateTime?
  deliveredAt       DateTime?

  // Audit : qui a créé ce colis
  createdById       String?
  createdBy         User?           @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  convoy            Convoy?         @relation(fields: [convoyId], references: [id])
  events            ShipmentEvent[]
  items             ShipmentItem[]
  payments          Payment[]
  invoice           Invoice?
  claims            ClaimRequest[]
  callbacks         CallbackRequest[]
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  label      String
  quantity   Int      @default(1)
  weightKg   Float?
  createdAt  DateTime @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  shipmentId  Int
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  amount      Float
  currency    Currency      @default(CAD)
  method      PaymentMethod @default(CASH)
  paidAt      DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())

  // Audit : qui a saisi ce paiement
  createdById String?
  createdBy   User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  subcategory String?
  amount      Float
  currency    Currency        @default(CAD)
  date        DateTime
  convoyId    String?
  convoy      Convoy?         @relation(fields: [convoyId], references: [id])
  notes       String?
  createdAt   DateTime        @default(now())

  // Audit : qui a saisi cette dépense
  createdById String?
  createdBy   User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String
  target    String
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([base, target])
}

// Journal des notifications envoyées par les utilisateurs
model NotificationLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Type de notification : CONVOY (template EN_ROUTE / IN_CUSTOMS / OUT_FOR_DELIVERY)
  // ou DELIVERED (remerciement individuel)
  type       String
  template   String?
  convoyId   String?
  shipmentId Int?
  sentCount  Int      @default(0)
  failedCount Int     @default(0)
  notes      String?
  createdAt  DateTime @default(now())
}

model ShipmentEvent {
  id          String    @id @default(cuid())
  type        String
  description String?
  location    String?
  occurredAt  DateTime? @default(now())
  createdAt   DateTime  @default(now())
  shipmentId  Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Convoy {
  id        String     @id @default(cuid())
  date      DateTime
  direction Direction  @default(NE_TO_CA)
  shipments Shipment[]
  expenses  Expense[]

  @@unique([date, direction])
}

enum Role {
  ADMIN
  AGENT_CA
  AGENT_NE
}

enum ShipmentStatus {
  CREATED
  RECEIVED_IN_NIGER // ✅ Statut initial pour NE→CA
  RECEIVED_IN_CANADA // ✅ Statut initial pour CA→NE
  IN_TRANSIT // En route
  IN_TRANSIT_STOP // En escale
  IN_CUSTOMS // À la douane
  READY_FOR_PICKUP // Prêt
  DELIVERED // Récupéré
}

enum Direction {
  NE_TO_CA
  CA_TO_NE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum Currency {
  CAD
  XOF
}

enum PaymentMethod {
  CASH
  TRANSFER
  MOBILE_MONEY
  OTHER
}

enum ExpenseCategory {
  SALARY
  CUSTOMS
  PACKAGING
  FUEL
  SHIPPING
  OTHER
}

// ============================================================================
// FONDATIONS FISCALES (Phase 1)
// ============================================================================

// Régimes fiscaux appliqués à une transaction
enum TaxRegime {
  TAX_INCLUDED   // Taxes comprises dans le prix annoncé
  TAX_EXCLUDED   // Taxes ajoutées au prix annoncé
  ZERO_RATED     // Service taxable au taux de 0 %
  TAX_EXEMPT     // Aucune taxe applicable
  OUT_OF_SCOPE   // Hors du champ d'application des taxes
}

// Profil de l'entreprise (singleton — une seule ligne active à la fois)
model CompanyProfile {
  id              String   @id @default(cuid())
  legalName       String                       // "NIMAPLEX INC." (dénomination sociale)
  displayName     String                       // "NIMAPLEX" (nom d'usage)
  neq             String?                      // Numéro d'entreprise du Québec
  gstNumber       String?                      // Numéro TPS (RT0001)
  qstNumber       String?                      // Numéro TVQ (TQ0001)
  address         String
  city            String
  province        String
  postalCode      String
  country         String   @default("Canada")
  email           String?
  phone           String?
  registeredAt    DateTime                     // Date d'incorporation
  fiscalYearStart Int      @default(1)         // Mois de début (1-12) — utile pour rapports annuels
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Taux de taxes configurables (TPS, TVQ, TVH, etc.)
// L'immutabilité passe par les colonnes validFrom/validTo et par le fait
// qu'une facture émise stocke un snapshot du taux dans TaxSnapshot (Phase 2)
model TaxRate {
  id           String    @id @default(cuid())
  name         String                          // "TPS", "TVQ", "TVH-ON"
  code         String                          // Code fonctionnel : "GST", "QST", "HST"
  rate         Decimal   @db.Decimal(7, 5)     // 0.05000, 0.09975 (max 99.99999) — 5 décimales pour taux comme TVQ 9,975 %
  jurisdiction String                          // "CA-federal", "CA-QC", "CA-ON"
  validFrom    DateTime                        // Date d'entrée en vigueur
  validTo      DateTime?                       // Date de fin (null = pas de fin)
  active       Boolean   @default(true)
  notes        String?                         // Ex: "TPS fédérale — Loi sur la taxe d'accise"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([code, active])
  @@index([jurisdiction, active])
}

// Règles fiscales configurables — moteur de détermination du régime applicable
// Chaque règle a une priorité (plus haute = évaluée en premier)
// La première règle dont tous les critères remplis s'applique
model TaxRule {
  id                 String    @id @default(cuid())
  name               String                     // "Transport international CA→NE"
  priority           Int       @default(0)      // Plus haut = évalué en premier
  originCountry      String?                    // Code pays : "CA", "NE" — null = n'importe
  destinationCountry String?                    // Code pays destination — null = n'importe
  clientProvince     String?                    // "QC", "ON", ... — null = n'importe
  serviceType        String?                    // "SHIPPING", "STORAGE", "OTHER" — null = n'importe
  regime             TaxRegime                  // Régime fiscal à appliquer
  taxRateCodes       String[]                   // Codes de TaxRate à appliquer (ex: ["GST","QST"])
  notes              String?                    // Justification légale, référence loi/annexe
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([active, priority])
}

// Journal d'audit générique — utilisable pour n'importe quelle entité
// À utiliser via lib/audit.ts::logAudit()
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  entityType String                              // "Invoice", "Expense", "TaxRate", "CompanyProfile"
  entityId   String                              // ID de l'entité concernée
  action     String                              // "CREATE", "UPDATE", "CANCEL", "REFUND", "DELETE", "LOGIN"
  before     Json?                               // Snapshot avant modification
  after      Json?                               // Snapshot après modification
  reason     String?                             // Raison utilisateur (annulation, remboursement)
  ipAddress  String?                             // Utile pour actions sensibles
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ============================================================================
// FACTURATION (Phase 2)
// ============================================================================

enum InvoiceStatus {
  DRAFT        // En cours de création (transitoire)
  ISSUED       // Émise, en attente de paiement
  PARTIAL      // Paiement partiel reçu
  PAID         // Payée intégralement
  CANCELLED    // Annulée (conservée pour l'audit — numéro non ré-utilisé)
  REFUNDED     // Remboursée
}

// Facture émise pour un envoi (relation 1:1 avec Shipment).
// Toutes les valeurs fiscales et d'entreprise sont snapshotées (immuables)
// pour préserver l'intégrité comptable même si TaxRate/CompanyProfile changent.
model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique              // "NIMA-2026-0001"
  fiscalYear         Int                                // 2026
  sequence           Int                                // 1, 2, 3...
  status             InvoiceStatus @default(ISSUED)

  // --- Client (dénormalisé pour immutabilité) ---
  clientName         String
  clientEmail        String?
  clientPhone        String?
  clientProvince     String?
  clientCountry      String?

  // --- Envoi lié ---
  shipmentId         Int?          @unique
  shipment           Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentTrackingId String?                            // Snapshot du tracking pour affichage

  // --- Montants (snapshot fiscal immuable) ---
  regime             TaxRegime                          // Régime fiscal appliqué
  amountBeforeTax    Decimal       @db.Decimal(12, 2)   // Sous-total HT
  totalTax           Decimal       @db.Decimal(12, 2)   // Somme des taxes
  totalIncludingTax  Decimal       @db.Decimal(12, 2)   // TTC (source de vérité — payé par le client)
  currency           String        @default("CAD")

  // --- Snapshot entreprise émettrice ---
  companyName        String
  companyAddress     String
  companyCity        String
  companyProvince    String
  companyPostalCode  String?
  companyCountry     String
  companyEmail       String?
  companyGstNumber   String?
  companyQstNumber   String?
  companyNeq         String?

  // --- Snapshot règle fiscale appliquée (pour audit) ---
  taxRuleId          String?
  taxRuleName        String?
  taxRuleNotes       String?

  // --- Cycle de vie ---
  issuedAt           DateTime      @default(now())
  dueDate            DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancelledReason    String?
  refundedAt         DateTime?

  items              InvoiceItem[]
  taxSnapshots       InvoiceTaxSnapshot[]

  createdById        String?
  createdBy          User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([fiscalYear, sequence])
  @@index([status, issuedAt])
  @@index([shipmentId])
  @@index([fiscalYear, sequence])
}

// Lignes de la facture. Une seule ligne pour l'instant (le service de transport)
// mais le modèle est pluriel pour permettre l'évolution (options, suppléments...)
model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description         String                             // "Service de transport de colis"
  detailedDescription String?                            // "Envoi NECA-0176 · Convoi 03/08/2026"
  quantity            Decimal  @db.Decimal(10, 4) @default(1)
  unitPrice           Decimal  @db.Decimal(12, 2)        // Prix unitaire HT (ou TTC selon régime)
  amountBeforeTax     Decimal  @db.Decimal(12, 2)        // Total HT ligne
  createdAt           DateTime @default(now())

  @@index([invoiceId])
}

// ============================================================================
// SUPPORT CLIENT (Phase 2.9) — plaintes et demandes de rappel
// ============================================================================

enum ClaimType {
  DAMAGED         // Colis endommagé
  MISSING         // Colis perdu / non reçu
  LATE            // Retard important
  WRONG_ITEM      // Mauvais contenu
  BILLING         // Problème de facturation
  OTHER
}

enum CallbackReason {
  DELIVERY_INFO     // Question sur la livraison
  PAYMENT           // Question sur le paiement / la facture
  ADDRESS_CHANGE    // Modification de l'adresse
  URGENT            // Urgent
  OTHER
}

enum RequestStatus {
  PENDING           // Nouveau, non traité
  IN_PROGRESS       // En cours de traitement
  RESOLVED          // Résolu
  CLOSED            // Fermé
}

// Plainte déposée par le client depuis la page de suivi publique
model ClaimRequest {
  id            String        @id @default(cuid())
  shipmentId    Int?
  shipment      Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  trackingId    String?                              // Snapshot pour affichage même si le colis est supprimé
  clientName    String
  clientEmail   String
  clientPhone   String?
  type          ClaimType
  description   String
  ipAddress     String?                              // Anti-spam / audit
  status        RequestStatus @default(PENDING)
  handledById   String?                              // Agent qui traite
  handledAt     DateTime?
  resolution    String?                              // Note de résolution interne
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([shipmentId])
  @@index([status, createdAt])
  @@index([trackingId])
}

// ============================================================================
// TRAÇABILITÉ ALIMENTAIRE (Phase 3.1) — module distinct pour l'ACIA
// ============================================================================

enum FoodLotStatus {
  IN_TRANSIT       // En cours d'importation
  DELIVERED        // Reçu, distribué aux clients
  RECALLED         // Rappelé (voir FoodRecall en Phase 3.4)
}

// Client acheteur de produits alimentaires (SÉPARÉ des receivers Shipment).
// Une seule fiche par personne physique/morale — nécessaire pour la
// traçabilité ACIA (retrouver rapidement qui a reçu quel lot).
model FoodClient {
  id             String     @id @default(cuid())
  customerCode   String     @unique                // "FCL-2026-0001" — auto-généré, immuable
  name           String                              // Nom / raison sociale
  address        String?
  city           String?
  province       String?
  postalCode     String?
  country        String     @default("Canada")
  phone          String?
  email          String?
  notes          String?                             // Notes internes admin
  active         Boolean    @default(true)           // Soft-delete
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sales          FoodSale[]
  complaints     FoodComplaint[]
  recallContacts RecallContact[]

  @@index([customerCode])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([active])
}

// Lot importé du Niger. Numéro unique pour ACIA. Une fois créé, le
// lotNumber ne change plus (traçabilité).
model FoodLot {
  id                String        @id @default(cuid())
  lotNumber         String        @unique          // "LOT-2026-001"
  description       String                         // Produits (riz, haricots, épices…)
  awbNumber         String?                        // N° AWB (transport aérien)
  supplier          String?                        // Fournisseur au Niger
  supplierCity      String?
  importDate        DateTime                       // Date d'importation
  quantityKg        Float                          // Quantité totale importée
  quantityRemaining Float?                         // Reste disponible (calcul rappel)
  status            FoodLotStatus @default(IN_TRANSIT)
  notes             String?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sales             FoodSale[]
  complaints        FoodComplaint[]
  recalls           FoodRecall[]

  @@index([lotNumber])
  @@index([status, importDate])
  @@index([supplier])
  @@index([active])
}

// Vente d'un lot à un client. Coeur de la traçabilité ACIA :
// permet de retrouver quels clients ont reçu quel lot en cas de rappel.
model FoodSale {
  id             String     @id @default(cuid())
  clientId       String
  client         FoodClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lotId          String
  lot            FoodLot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantityKg     Float                                  // Quantité vendue à ce client
  productDetails String?                                // Détails de la marchandise vendue (ex : "riz basmati 5 kg + haricots 2 kg")
  saleDate       DateTime   @default(now())
  price          Float?                                 // Facultatif — prix payé
  currency       Currency   @default(CAD)
  notes          String?

  createdById    String?
  createdBy      User?      @relation("FoodSaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([clientId])
  @@index([lotId])
  @@index([saleDate])
  @@index([clientId, saleDate])
  @@index([lotId, saleDate])
}

// ============================================================================
// PLAINTES ALIMENTAIRES — Article 82 RSAC (Phase 3.3)
// ============================================================================
// Registre officiel des plaintes. Conservation obligatoire 2 ans (Article 82).
// Chaque plainte suit un workflow d'enquête complet avec traçabilité fournisseur
// et notification ACIA (CFIA) si applicable.

enum ComplaintChannel {
  PHONE            // Téléphone
  EMAIL            // Courriel
  WEBSITE_FORM     // Formulaire /food/plainte
  IN_PERSON        // En personne
  MAIL             // Courrier postal
  OTHER
}

enum HealthRiskCategory {
  BIOLOGICAL       // Bactéries, moisissures, contamination microbio
  CHEMICAL         // Résidus chimiques, allergène non déclaré
  PHYSICAL         // Corps étranger (verre, métal, plastique)
  QUALITY          // Qualité (goût, texture, apparence, péremption)
  OTHER
  NONE             // Pas un risque santé (ex : livraison en retard)
}

enum ComplaintRiskLevel {
  HIGH             // Risque élevé — potentiellement dangereux
  MEDIUM           // Risque moyen
  LOW              // Risque faible
  NONE             // Aucun risque santé
}

enum ComplaintStatus {
  RECEIVED             // Reçue, à investiguer
  INVESTIGATION        // Enquête en cours
  SUPPLIER_CONTACTED   // Fournisseur étranger contacté
  RESPONDED            // Client informé des mesures
  RESOLVED             // Résolue (remboursement/remplacement effectué)
  CLOSED               // Fermée (dossier archivé)
}

enum ComplaintResolution {
  REPLACEMENT          // Remplacement du produit
  REFUND               // Remboursement
  APOLOGY_ONLY         // Excuses uniquement
  NO_ACTION_NEEDED     // Aucune action nécessaire
  RECALL_INITIATED     // A déclenché un rappel
  OTHER
}

model FoodComplaint {
  id                     String              @id @default(cuid())
  complaintNumber        String              @unique                     // "PLA-YYYY-NNNN"

  // --- 1. RÉCEPTION (Article 82 RSAC) ---
  channel                ComplaintChannel                                // Comment reçue
  receivedAt             DateTime            @default(now())             // Date de réception

  // --- Client concerné ---
  // Peut ne PAS être en base (client inconnu ou nouveau)
  clientId               String?
  client                 FoodClient?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientNameSnapshot     String                                          // Nom (snapshot, immuable pour audit)
  clientEmail            String?
  clientPhone            String?

  // --- Lot concerné (peut être null si client ne connaît pas le n° de lot) ---
  lotId                  String?
  lot                    FoodLot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lotNumberSnapshot      String?                                         // "LOT-2026-0001" snapshot

  // --- 2. Nature du problème ---
  natureCategory         HealthRiskCategory                              // Catégorie de risque
  natureDescription      String                                          // Description détaillée (obligatoire)
  productDescription     String?                                         // Produit concerné (ex : "riz basmati 5kg")

  // --- 3. ÉVALUATION du risque santé ---
  isHealthRisk           Boolean             @default(false)             // Représente un risque pour la santé ?
  riskLevel              ComplaintRiskLevel  @default(LOW)

  // --- 4. ENQUÊTE (workflow) ---
  status                 ComplaintStatus     @default(RECEIVED)
  investigationNotes     String?                                         // Journal d'enquête (peut être long)
  traceabilityChecked    Boolean             @default(false)             // Registre traçabilité vérifié ?
  traceabilityCheckedAt  DateTime?

  supplierContacted      Boolean             @default(false)             // Fournisseur étranger contacté ?
  supplierContactedAt    DateTime?
  supplierResponse       String?

  // --- 5. RÉPONSE au client ---
  respondedAt            DateTime?
  responseChannel        ComplaintChannel?
  responseSummary        String?
  resolution             ComplaintResolution?
  resolutionNotes        String?

  // --- 6. MESURES CORRECTIVES ---
  correctiveMeasures     String?

  // --- 7. NOTIFICATION ACIA (CFIA) ---
  cfiaNotificationRequired Boolean           @default(false)             // ACIA doit-elle être avisée ?
  cfiaNotifiedAt         DateTime?
  cfiaReference          String?                                         // N° de dossier ACIA

  // --- 8. Rappel déclenché ---
  triggeredRecall        Boolean             @default(false)             // A déclenché un rappel ?
  triggeredRecalls       FoodRecall[]        @relation("ComplaintTriggeredRecall")

  // --- 9. RÉTENTION (Article 82 : min. 2 ans) ---
  retentionUntil         DateTime                                        // = receivedAt + 2 ans

  // --- Audit ---
  ipAddress              String?                                         // Si soumise via formulaire public
  createdById            String?
  createdBy              User?               @relation("FoodComplaintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  handledById            String?
  handledBy              User?               @relation("FoodComplaintHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([complaintNumber])
  @@index([status, receivedAt])
  @@index([lotId])
  @@index([clientId])
  @@index([riskLevel, status])
  @@index([cfiaNotificationRequired, cfiaNotifiedAt])
  @@index([channel, receivedAt])
}

// Demande de rappel téléphonique depuis la page de suivi publique
model CallbackRequest {
  id            String         @id @default(cuid())
  shipmentId    Int?
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  trackingId    String?
  clientName    String
  clientPhone   String                              // Obligatoire pour rappeler
  clientEmail   String?
  reason        CallbackReason
  message       String?
  preferredTime String?                             // "matin", "après-midi", "soir"
  ipAddress     String?
  status        RequestStatus  @default(PENDING)
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([shipmentId])
  @@index([status, createdAt])
  @@index([trackingId])
}

// Snapshot immuable d'une taxe appliquée sur une facture.
// Chaque ligne = une taxe (TPS, TVQ) avec son taux et son montant figés
// au moment de l'émission — préserve l'intégrité comptable.
model InvoiceTaxSnapshot {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRateId     String?                                  // Référence (nullable si TaxRate supprimé)
  code          String                                   // "GST", "QST"
  name          String                                   // "TPS", "TVQ"
  rate          Decimal  @db.Decimal(7, 5)               // Taux figé
  jurisdiction  String
  amount        Decimal  @db.Decimal(12, 2)              // Montant taxe calculé

  @@index([invoiceId])
  @@index([code, invoiceId])
}

// ============================================================================
// RAPPELS ALIMENTAIRES — Article 7 procédure interne (Phase 3.4)
// ============================================================================
// Cœur de la traçabilité ACIA : retrouver en secondes tous les clients
// ayant reçu un lot, initier le contact, tracer les retours/destructions.
// Inclut la simulation annuelle (RSAC exige 1 simulation/an, rétention 2 ans).

enum RecallType {
  REAL              // Vrai rappel
  SIMULATION        // Simulation annuelle (Article 7)
}

enum RecallReason {
  BIOLOGICAL_HAZARD         // Contamination microbiologique
  CHEMICAL_HAZARD           // Contamination chimique
  PHYSICAL_HAZARD           // Corps étranger
  UNDECLARED_ALLERGEN       // Allergène non déclaré
  QUALITY_DEFECT            // Défaut qualité
  REGULATORY_REQUIREMENT    // Exigence réglementaire ACIA
  VOLUNTARY                 // Rappel volontaire
  OTHER
}

// Classification ACIA officielle
enum RecallClassification {
  CLASS_I           // Risque grave pour la santé (conséquences graves)
  CLASS_II          // Risque temporaire ou réversible
  CLASS_III         // Peu ou pas de risque santé (étiquetage)
}

enum RecallStatus {
  DRAFT             // En préparation
  ACTIVE            // Rappel officiellement lancé, contacts en cours
  MONITORING        // Récupération/destruction en cours
  COMPLETED         // Toutes les actions terminées
  CLOSED            // Rapport de clôture archivé
}

model FoodRecall {
  id                     String              @id @default(cuid())
  recallNumber           String              @unique                       // "RAP-YYYY-NNNN"
  type                   RecallType          @default(REAL)
  status                 RecallStatus        @default(DRAFT)

  // --- Lot concerné ---
  lotId                  String
  lot                    FoodLot             @relation(fields: [lotId], references: [id], onDelete: Restrict)

  // --- Motif + classification ---
  reason                 RecallReason
  classification         RecallClassification
  description            String

  // --- Plainte déclencheur (facultatif) ---
  triggeringComplaintId  String?
  triggeringComplaint    FoodComplaint?      @relation("ComplaintTriggeredRecall", fields: [triggeringComplaintId], references: [id], onDelete: SetNull)

  // --- Cycle de vie ---
  initiatedAt            DateTime            @default(now())
  activatedAt            DateTime?
  completedAt            DateTime?
  closedAt               DateTime?

  // --- Communication publique ---
  publicNoticeText       String?
  publicNoticeUrl        String?

  // --- Notification ACIA ---
  cfiaNotifiedAt         DateTime?
  cfiaReference          String?
  cfiaNoticeUrl          String?

  // --- Bilan quantitatif ---
  quantityRecovered      Float?                                            // kg récupérés
  quantityDestroyed      Float?                                            // kg détruits

  // --- Rapport de clôture (Article 7 + rétention 2 ans) ---
  closureReport          String?
  retentionUntil         DateTime                                          // = initiatedAt + 2 ans

  contacts               RecallContact[]

  createdById            String?
  createdBy              User?               @relation("FoodRecallCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([recallNumber])
  @@index([lotId])
  @@index([status, initiatedAt])
  @@index([type, status])
  @@index([classification, status])
}

// Un contact par client affecté par le rappel (auto-généré depuis FoodSale)
model RecallContact {
  id                 String            @id @default(cuid())
  recallId           String
  recall             FoodRecall        @relation(fields: [recallId], references: [id], onDelete: Cascade)

  clientId           String
  client             FoodClient        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // --- Snapshot au moment de la génération (immuable) ---
  clientNameSnapshot String                                                // Nom du client au moment du rappel
  quantityReceived   Float                                                 // Total kg reçu (somme FoodSale)

  // --- Contact ---
  contactedAt        DateTime?                                             // Quand contacté (null = pas encore)
  contactChannel     ComplaintChannel?                                     // Réutilise l'enum des plaintes
  contactNotes       String?

  // --- Retour du produit ---
  productReturned    Boolean           @default(false)
  quantityReturned   Float?
  returnedAt         DateTime?

  // --- Destruction ---
  quantityDestroyed  Float?
  destroyedAt        DateTime?

  notes              String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([recallId, clientId])
  @@index([recallId])
  @@index([clientId])
  @@index([contactedAt])
}
